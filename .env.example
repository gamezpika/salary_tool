# 复制成 .env 再修改。.env 不要提交到 Git。

# 第一个管理员账号。第一次启动后，这个密码必须改掉。
ADMIN_ACCOUNT=admin
# 留空的话，启动时会产生一组临时密码并印在日志里（只印一次）
ADMIN_INITIAL_PASSWORD=

# 查链上余额用。只存在服务器上，不会进浏览器。留空就不能查余额。
TRONSCAN_API_KEY=

# 闲置多久要重新登录（分钟）、最长登录多久（小时）
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# 资料来源：excel（目前）或 oa（串接 OA 后）
DATA_SOURCE=excel
OA_BASE_URL=
OA_TOKEN=

# 只有在本机试用（没有 HTTPS）才设 false，正式环境不要设
# COOKIE_SECURE=false
